{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Windows",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Web (Emscripten)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build_wasm"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Android",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build_android"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Linux",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build_linux"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build macOS",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build_macos"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Web Server (Python)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8000",
                "--directory",
                "${workspaceFolder}/build_wasm/bin"
            ],
            "problemMatcher": []
        }
    ]
}
